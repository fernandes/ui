<%# Drawer Title Component - names the drawer (aria-labelledby is wired by the controller) %>
<%
  content ||= local_assigns.fetch(:content, nil)
  @classes = local_assigns.fetch(:classes, "")
  @attributes = local_assigns.fetch(:attributes, {})

  # Extend behavior for shared logic
  extend UI::DrawerTitleBehavior

-%>
<%= content_tag :h2, **drawer_title_html_attributes do %>
  <%= content || yield %>
<% end %>
