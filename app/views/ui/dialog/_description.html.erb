<%# Dialog Description Component - describes the dialog (aria-describedby is wired by the controller) %>
<%
  content ||= local_assigns.fetch(:content, nil)
  @classes = local_assigns.fetch(:classes, "")
  @attributes = local_assigns.fetch(:attributes, {})

  extend UI::DialogDescriptionBehavior
-%>
<%= content_tag :p, **dialog_description_html_attributes do %>
  <%= content || yield %>
<% end %>
