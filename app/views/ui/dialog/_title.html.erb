<%# Dialog Title Component - names the dialog (aria-labelledby is wired by the controller) %>
<%
  content ||= local_assigns.fetch(:content, nil)
  @classes = local_assigns.fetch(:classes, "")
  @attributes = local_assigns.fetch(:attributes, {})

  extend UI::DialogTitleBehavior
-%>
<%= content_tag :h2, **dialog_title_html_attributes do %>
  <%= content || yield %>
<% end %>
