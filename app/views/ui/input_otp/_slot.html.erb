<%# InputOtp Slot - ERB partial

  Draws one character of the OTP input's value (decorative, aria-hidden).

  @param index [Integer] Index of the slot in the OTP sequence (default: 0)
  @param value [String] Pre-filled character (becomes part of the input's value)
  @param name [String] Fallback name when the root has none (kept for compatibility; prefer name: on ui/input_otp)
  @param id [String] Ignored (kept for compatibility; set id: on ui/input_otp)
  @param disabled [Boolean] Disables the whole OTP input
  @param classes [String] Additional CSS classes
  @param attributes [Hash] Additional HTML attributes
%>
<%
  @index = local_assigns.fetch(:index, 0)
  @value = local_assigns.fetch(:value, "")
  @slot_name = local_assigns.fetch(:name, nil)
  @disabled = local_assigns.fetch(:disabled, false)
  @classes = local_assigns.fetch(:classes, "")
  @attributes = local_assigns.fetch(:attributes, {})

  # Extend behavior for shared logic
  extend UI::InputOtpSlotBehavior

  # Partials share the view's ivars: start fresh for this slot.
  @input_otp_slot_registered = nil

  # Get HTML attributes from behavior
  slot_attrs = input_otp_slot_html_attributes.deep_merge(@attributes)
  slot_char = input_otp_slot_char
-%>
<%= content_tag :div, **slot_attrs do %><%= slot_char %><%= content_tag :div, content_tag(:div, "", class: input_otp_caret_line_classes), class: input_otp_caret_classes %><% end %>
